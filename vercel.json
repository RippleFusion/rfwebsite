{
  "cleanUrls": true,
  "redirects": [
    { "source": "/about", "destination": "/#the-problem", "permanent": false },
    { "source": "/services", "destination": "/#how-i-work", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
